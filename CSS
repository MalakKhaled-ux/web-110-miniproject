* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Open Sans', sans-serif;  
    background: black;
    color: white;
    line-height: 1.6;
}

.wrapper {
    min-height: 100vh;
    background: linear-gradient(
        to bottom,
        rgba(255, 64, 50, 0.8),
        rgba(71, 17, 116, 0.9)
    ),
    url(file:///Users/malakkhaled/Desktop/BONO-LANDING-FORM/images/background.jpg) no-repeat center / cover;
    
    /* Makes sure the main content is pushed down properly below the header */
    display: flex;
    flex-direction: column; 
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30px;
}

.header .logo {
    width: 100px;
}

.header .header-right {
    display: flex;
    align-items: center;
    gap: 25px;
    font-size: 14px;
}

.header .header-right i {
    margin-right: 5px;
}

.header .header-right a {
    color: white;
}

.header .header-right a:hover {
    color: #ff4032;
}

.main-content {
    display: flex;
    gap: 50px;
    max-width: 1100px;
    margin: 0 auto;
    justify-content: center;
    align-items: center;
    flex: 1;
    padding: 0 40px;
    width: 100%;
}

.main-content form {
    flex: 1;
}

.form-group {
    margin-bottom: 15px;
}

.form-group label {
    display: block;
    margin-bottom: 5px;
    font-size: 14px;
    font-weight: 600;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 15px;
    border: none;
    border-radius: 5px;
    font-size: 14px;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    outline: none;
}

.form-group textarea {
    resize: none;
    height: 120px;
}

.btn {
    display: block;
    width: 100%;
    padding: 15px;
    border: none;
    border-radius: 20px;
    background: #ff4032;
    color: white;
    font-size: 16px;    
    cursor: pointer;
    margin-top: 10px;
}

.btn:hover {
    background: #ff5c4d;
}

.text-container {
    flex: 1;
}

.text-container h1 {
    font-size: 50px;
    margin-bottom: 20px;
    line-height: 1.2;
}

.text-container p {
    font-size: 18px;
    line-height: 1.5;
}

@media (max-width: 768px) {
    .header {
        padding: 30px 10px 10px;
    }

    .header-right {
        flex-direction: column;
        align-items: center;
        padding: 0 20px;
        gap: 10px;
    }

    .main-content {
        flex-direction: column-reverse;
        justify-content: start;
        margin: auto;
        padding: 50px 20px;
    }

    .main-content form, .text-container {
        width: 100%;
    }
}

@media (max-height: 500px) {
    .main-content {
        margin: 0 auto;
    }

    .text-container h1 {
        font-size: 40px;
    }
}

